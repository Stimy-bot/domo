{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "moduleResolution": "Nodenext",
    "jsx": "react-jsx",
    "types": ["vitest/globals", "vitest/importMeta", "vite/client", "node"],
    "outDir": "../../../dist/libs/shared/ui-buttons",
    "tsBuildInfoFile": "../../../dist/libs/shared/ui-buttons.tsbuildinfo"
  },
  "include": [
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx",
    "src/**/*.d.ts"
  ]
}
