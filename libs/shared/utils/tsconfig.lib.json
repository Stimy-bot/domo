{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "outDir": "../../../dist/out-tsc",
    "tsBuildInfoFile": "../../../dist/libs/shared/utils/tsconfig.lib.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
 "node_modules",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.test.ts",
    "**/*.test.tsx"
  ],
  "references": [
    {
      "path": "../types/tsconfig.lib.json"
    },
    {
      "path": "../constants/tsconfig.lib.json"
    }
  ]
}
