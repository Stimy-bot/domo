{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "outDir": "../../../dist/libs/shared/hooks",
    "tsBuildInfoFile": "../../../dist/libs/shared/hooks.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "apps/**/*.ts",
    "libs/**/*.ts",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "jest.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ],
  "references": [
    {
      "path": "../firebase/tsconfig.lib.json"
    },
    {
      "path": "../types/tsconfig.lib.json"
    },
    {
      "path": "../validates/tsconfig.lib.json"
    },
    {
      "path": "../schemas/tsconfig.lib.json"
    },
    {
      "path": "../client/tsconfig.lib.json"
    },
    {
      "path": "../constants/tsconfig.lib.json"
    }
  ]
}
