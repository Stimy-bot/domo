{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "outDir": "../../../dist/out-tsc",
    "tsBuildInfoFile": "../../../dist/libs/shared/ui-header/tsconfig.lib.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "apps/**/*.ts",
    "libs/**/*.ts",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "jest.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/*.test.tsx", 
    "src/**/*.spec.tsx"],
  "references": [
    {
      "path": "../state/tsconfig.lib.json"
    }
  ]
}
