{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "composite": true,
    "declaration": true,
    "outDir": "../../../dist/out-tsc",
    "tsBuildInfoFile": "../../../dist/libs/shared/forms/tsconfig.lib.tsbuildinfo"
  },
"include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.test.ts",
    "**/*.test.tsx"
  ],
  "references": [
    {
      "path": "../firebase/tsconfig.lib.json"
    },
    {
      "path": "../client/tsconfig.lib.json"
    },
    {
      "path": "../schemas/tsconfig.lib.json"
    },
    {
      "path": "../utils/tsconfig.lib.json"
    },
    {
      "path": "../hooks/tsconfig.lib.json"
    },
    {
      "path": "../constants/tsconfig.lib.json"
    },
    {
      "path": "../config/tsconfig.lib.json"
    },
    {
      "path": "../reusableComponents/tsconfig.lib.json"
    }
  ]
}
