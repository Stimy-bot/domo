{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "../../../dist/libs/shared/middleware",
    "rootDir": "../../..",
    "composite": true,
    "declaration": true,
    "types": ["node"]
  },
  "exclude": ["**/*.spec.*", "**/*.test.*", "vite.config.*", "vitest.config.*"],
  "include": ["src/**/*.js", "src/**/*.jsx", "src/**/*.ts", "src/**/*.tsx"],
  "references": [
    {
      "path": "../schemas/tsconfig.lib.json"
    },
    {
      "path": "../services/tsconfig.lib.json"
    },
    {
      "path": "../models/tsconfig.lib.json"
    },
    {
      "path": "../config/tsconfig.lib.json"
    },
    {
      "path": "../utils/tsconfig.lib.json"
    },
    {
      "path": "../constants/tsconfig.lib.json"
    }
  ]
}
