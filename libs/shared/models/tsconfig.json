{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "../../../dist/libs/shared/models",
    "tsBuildInfoFile": "../../../dist/libs/shared/models.tsbuildinfo"
  },
  "include": [
    "src/**/*", 
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.tsx",
    "apps/**/*.ts",
    "libs/**/*.ts",
    "types/**/*.d.ts"
  ],
  "references": [
    {
      "path": "../constants"
    },
    {
      "path": "../utils"
    },
    {
      "path": "../schemas"
    }
  ]
}
