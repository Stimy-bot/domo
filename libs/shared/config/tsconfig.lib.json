{
  "extends": "./tsconfig.json",
  "compilerOptions": {
        "jsx": "react-jsx",
    "composite": true,
    "incremental": true,
    "rootDir": "src",
    "outDir": "../../../dist/libs/shared/config",
    "tsBuildInfoFile": "../../../dist/libs/shared/config/tsconfig.lib.tsbuildinfo"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "apps/**/*.ts", "libs/**/*.ts", "types/**/*.d.ts"],
    "references": [
    {
      "path": "../models/tsconfig.lib.json"
    },
    {
      "path": "../utils/tsconfig.lib.json"
    }
  ]
}
