{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "jsx": "react-jsx",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "../../../dist/libs/shared/reusableComponents",
    "tsBuildInfoFile": "../../../dist/libs/shared/reusableComponents.tsbuildinfo"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.test.ts",
    "**/*.test.tsx"
  ],
  "references": [
    {
      "path": "../client"
    },
    {
      "path": "../ui-header"
    },
    {
      "path": "../ui-footer"
    },
    {
      "path": "../hooks"
    },
    {
      "path": "../context"
    },
    {
      "path": "../utils"
    }
  ]
}
