{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "outDir": "../../../dist/out-tsc",
    "tsBuildInfoFile": "../../../dist/libs/shared/reusableComponents/tsconfig.lib.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "apps/**/*.ts",
    "libs/**/*.ts",
    "types/**/*.d.ts"
  ],
  "exclude": ["jest.config.ts", "src/**/*.spec.ts", "src/**/*.test.ts"],
  "references": [
    {
      "path": "../ui-footer/tsconfig.lib.json"
    },
    {
      "path": "../ui-header/tsconfig.lib.json"
    },
    {
      "path": "../utils/tsconfig.lib.json"
    },
    {
      "path": "../hooks/tsconfig.lib.json"
    },
    {
      "path": "../context/tsconfig.lib.json"
    }
  ]
}
