{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
"composite": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "../../../dist/out-tsc"
  },
  "include": [
    "src/**/*.ts", "src/**/*.tsx",
    "src/**/*.tsx"
