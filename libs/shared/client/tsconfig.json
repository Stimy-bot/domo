{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "types": ["node"],
    "jsx": "react-jsx"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
 "node_modules",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.test.ts",
    "**/*.test.tsx"
  ],
  "references": [
    {
      "path": "../types"
    },
    {
      "path": "../config"
    },
    {
      "path": "../schemas"
    },
    {
      "path": "../utils"
    }
  ]
}
