{
  "name": "@domo/source",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start:py": ".venv/bin/python main.py",
    "test:py": ".venv/bin/pytest",
    "build": "nx run-many --target=build --all --configuration=production --skip-nx-cache",
    "build:api": "nx run @domo/api:build:production --skip-nx-cache",
    "build:libs": "nx run-many --target=build --projects=@domo/types,@domo/constants,@domo/schemas,@domo/validates,@domo/utils,@domo/models,@domo/services,@domo/config,@domo/controllers,@domo/middleware --configuration=production --skip-nx-cache",
    "lint": "biome lint --write .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "private": true,
  "pnpm": {
    "overrides": {
      "@tanstack/react-query": "5.104.4",
      "@tanstack/query-core": "5.104.4"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "typescript": "6"
      },
      "allowAny": [
        "typescript"
      ]
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  },
  "workspaces": [
    "apps/*",
    "libs/shared/*",
    "packages/*",
    "tools/*"
