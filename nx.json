{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "analytics": false,
  "install": {
    "npmInstall": false,
    "usePnpm": true
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/eslint.config.mjs",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/src/test-setup.[jt]s",
      "!{projectRoot}/**/*.md",
      "!{projectRoot}/.env.local",
      "!{projectRoot}/.env.*.local"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/pnpm-lock.yaml"
    ]
  },
  "plugins": [
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    },
    {
      "plugin": "@nx/vite/plugin",
      "options": {
        "buildTargetName": "build",
        "serveTargetName": "serve",
        "devTargetName": "dev",
        "previewTargetName": "preview",
        "serveStaticTargetName": "serve-static",
        "typecheckTargetName": "typecheck",
        "buildDepsTargetName": "build-deps",
        "watchDepsTargetName": "watch-deps"
      }
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "testTargetName": "test",
        "ciTargetName": "test-ci",
        "testMode": "watch"
      }
    },
    {
      "plugin": "@nx/playwright/plugin",
      "options": {
        "targetName": "e2e"
      }
    }
  ],
  "generators": {
    "@nx/react": {
      "application": {
        "babel": true,
        "style": "css",
        "linter": "eslint",
        "bundler": "vite"
      },
      "component": {
        "style": "css"
      },
      "library": {
        "style": "css",
        "linter": "eslint",
        "unitTestRunner": "vitest"
      }
    }
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": [
        "{projectRoot}/dist",
        "{workspaceRoot}/dist/{projectRoot}",
        "{options.outputPath}"
      ]
    },
    "@nx/js:tsc": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": ["{options.outputPath}", "{projectRoot}/dist"]
    },
    "typecheck": {
      "cache": true,
      "inputs": ["default", "^production"]
    },
    "lint": {
      "cache": true,
      "inputs": ["default"]
    },
    "test": {
      "cache": true,
      "inputs": ["default", "^production"]
    },
    "serve": {
      "dependsOn": [
        {
          "target": "build",
          "dependencies": true
        }
      ]
    }
  },
  "projects": {
    "@domo/types": "libs/shared/types",
    "@domo/constants": "libs/shared/constants",
    "@domo/utils": "libs/shared/utils",
    "@domo/schemas": "libs/shared/schemas",
    "@domo/context": "libs/shared/context",
    "@domo/services": "libs/shared/services",
    "@domo/models": "libs/shared/models",
    "@domo/firebase": "libs/shared/firebase",
    "@domo/state": "libs/shared/state",
    "@domo/client": "libs/shared/client",
    "@domo/config": "libs/shared/config",
    "@domo/controllers": "libs/shared/controllers",
    "@domo/forms": "libs/shared/forms",
    "@domo/hooks": "libs/shared/hooks",
    "@domo/middleware": "libs/shared/middleware",
    "@domo/reusableComponents": "libs/shared/reusableComponents",
    "@domo/ui-buttons": "libs/shared/ui-buttons",
    "@domo/ui-footer": "libs/shared/ui-footer",
    "@domo/ui-header": "libs/shared/ui-header",
    "@domo/ui-sidebar": "libs/shared/ui-sidebar",
    "@domo/validates": "libs/shared/validates",
    "@domo/tailwind-sync-plugin": "libs/shared/tailwind-sync-plugin",
    "@domo/my-start": "apps/my-start",
    "@domo/my-vite": "apps/my-vite",
    "@domo/api": "apps/api"
  }
}
