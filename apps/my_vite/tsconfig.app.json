{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "types": [
      "node",
      "vite-plugin-node-polyfills",
      "vite/client",
      "vitest/globals",
      "vitest/importMeta"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "apps/**/*.ts",
    "libs/**/*.ts",
    "types/**/*.d.ts"
  ],
  "references": [
    {
      "path": "../../libs/shared/forms/tsconfig.lib.json"
    },
    {
      "path": "../../libs/shared/context/tsconfig.lib.json"
    },
    {
      "path": "../../libs/shared/reusableComponents/tsconfig.lib.json"
    }
  ]
}
