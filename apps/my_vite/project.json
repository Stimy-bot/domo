{
  "name": "@domo/my_vite",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "tags": ["type:app"],
  "sourceRoot": "apps/my_vite/src",
  "projectType": "application",
  "targets": {
    "build": {
      "command": "vite build -c vite.config.mts",
      "options": {
        "cwd": "apps/my_vite"
      },
      "syncGenerators": [
        "@domo/tailwind-sync-plugin:update-tailwind-globs"
      ]
    },
    "serve": {
      "command": "vite -c vite.config.mts",
      "options": {
        "cwd": "apps/my_vite"
      },
      "syncGenerators": [
        "@domo/tailwind-sync-plugin:update-tailwind-globs"
      ]
    },
    "dev": {
      "command": "vite -c vite.config.mts",
      "options": {
        "cwd": "apps/my_vite"
      }
    },
    "preview": {
      "command": "vite preview -c vite.config.mts",
      "options": {
        "cwd": "apps/my_vite"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "apps/my_vite/**/*.ts",
          "apps/my_vite/**/*.tsx",
          "apps/my_vite/**/*.mts"
        ]
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "options": {
        "passWithNoTests": true
      }
    }
  }
}