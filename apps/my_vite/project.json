{
  "name": "@domo/my_vite",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/my_vite/src",
  "projectType": "application",
  "tags": ["type:app"],
  "targets": {
    "build": {
      "command": "vite build -c vite.config.mts",
      "syncGenerators": ["@domo/tailwind-sync-plugin:update-tailwind-globs"],
      "options": {
        "cwd": "apps/my_vite"
      }
    },
    "serve": {
      "command": "vite -c vite.config.mts",
      "syncGenerators": ["@domo/tailwind-sync-plugin:update-tailwind-globs"],
      "options": {
        "cwd": "apps/my_vite"
      }
    },
    "dev": {
      "command": "vite -c vite.config.mts",
      "options": {
        "cwd": "apps/my_vite"
      }
    },
    "preview": {
      "command": "vite preview -c vite.config.mts",
      "options": {
        "cwd": "apps/my_vite"
      }
    },
    "lint": {
      "options": {
        "args": ["**/*.ts", "**/*.tsx", "**/*.mts"]
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "options": {
        "passWithNoTests": true
      }
    }
  }
}
