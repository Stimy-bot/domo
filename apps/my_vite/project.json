{
  "name": "@domo/my_vite",
  "projectType": "application",
  "sourceRoot": "apps/my_vite/src",
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "options": {
        "outputPath": "dist/apps/my_vite",
        "config": "apps/my_vite/vite.config.mts"
      }
    },
    "serve": {
      "executor": "@nx/vite:dev",
      "options": {
        "buildTarget": "@domo/my_vite:build",
        "config": "apps/my_vite/vite.config.mts"
      }
    }
  }
}
