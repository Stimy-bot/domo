{
  "name": "@domo/my_fastapi",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/my_fastapi/app",
  "tags": ["type:app", "language:python"],
  "targets": {
    "add": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv add {args}",
        "cwd": "apps/my_fastapi"
      }
    },
    "remove": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv remove {args}",
        "cwd": "apps/my_fastapi"
      }
    },
    "sync": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv sync",
        "cwd": "apps/my_fastapi"
      }
    },
    "lock": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv lock",
        "cwd": "apps/my_fastapi"
      }
    },
    "mongo": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker start domo-mongo || docker run -d --name domo-mongo -p 27017:27017 mongo:latest"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": ".venv/bin/uvicorn main:app --reload",
        "cwd": "apps/my_fastapi"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "outputs": ["{workspaceRoot}/coverage/apps/my_fastapi"],
        "command": "uv run pytest",
        "cwd": "apps/my_fastapi"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "../../.venv/bin/ruff check .",
        "cwd": "apps/my_fastapi"
      }
    }
  }
}
