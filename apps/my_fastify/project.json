{
  "name": "@domo/my_fastify",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/my_fastify/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/my_fastify",
        "main": "apps/my_fastify/src/main.ts",
        "tsConfig": "apps/my_fastify/tsconfig.app.json",
        "platform": "node",
        "format": ["esm"],
        "bundle": true,
        "thirdParty": false,
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/my_fastify/src/public",
            "output": "public"
          },
          {
            "glob": "**/*",
            "input": "apps/my_fastify/src/views",
            "output": "views"
          },
          {
            "glob": "**/*",
            "input": "apps/my_fastify/src/app/plugins",
            "output": "plugins"
          },
          {
            "glob": "**/*",
            "input": "apps/my_fastify/src/app/routes",
            "output": "routes"
          }
        ]
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "options": {
        "buildTarget": "@domo/my_fastify:build",
        "inspect": true,
        "runtimeArgs": ["--env-file=.env"]
      },
      "configurations": {
        "development": {
          "buildTarget": "@domo/my_fastify:build:development"
        }
      }
    },
    "lint": {
      "options": {
        "args": ["**/*.ts"]
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "options": {
        "passWithNoTests": true
      }
    }
  }
}
