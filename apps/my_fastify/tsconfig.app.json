{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/apps/my_fastify",
    "rootDir": "src"
  },
  "include": [
    "src/**/*",
    "src/**/*.ts",
    "src/**/*.tsx",
    "types/**/*.d.ts",
       "../../libs/**/*.ts",
    "../../libs/**/*.tsx",
    "../../types/**/*.d.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "**/*.spec.ts",
    "**/*.test.ts",
    "../../dist",
    "../../node_modules",
    "node_modules"
  ],
  "references": [
    { "path": "../../libs/shared/utils" },
    { "path": "../../libs/shared/validates" },
    { "path": "../../libs/shared/models" },
    { "path": "../../libs/shared/config" },
    { "path": "../../libs/shared/controllers" },
    { "path": "../../libs/shared/types" },
    { "path": "../../libs/shared/services" },
    { "path": "../../libs/shared/schemas" },
    { "path": "../../libs/shared/constants" },
    { "path": "../../libs/shared/middleware" }
  ]
}
