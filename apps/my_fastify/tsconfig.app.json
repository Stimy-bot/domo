{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/apps/my_fastify",
    "rootDir": "src"
  },
  "include": [
    "src/**/*",
    "src/**/*.ts",
    "src/**/*.tsx",
    "types/**/*.d.ts",
    "../../libs/**/*.ts",
    "../../libs/**/*.tsx",
    "../../types/**/*.d.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "**/*.spec.ts",
    "**/*.test.ts",
    "../../dist",
    "../../node_modules",
    "node_modules"
  ],
  "references": [
    {
      "path": "../../libs/shared/utils/tsconfig.lib.json"
    },
    {
      "path": "../../libs/shared/validates/tsconfig.lib.json"
    },
    {
      "path": "../../libs/shared/models/tsconfig.lib.json"
    },
    {
      "path": "../../libs/shared/config/tsconfig.lib.json"
    },
    {
      "path": "../../libs/shared/controllers/tsconfig.lib.json"
    },
    {
      "path": "../../libs/shared/types/tsconfig.lib.json"
    },
    {
      "path": "../../libs/shared/services/tsconfig.lib.json"
    },
    {
      "path": "../../libs/shared/schemas/tsconfig.lib.json"
    },
    {
      "path": "../../libs/shared/constants/tsconfig.lib.json"
    },
    {
      "path": "../../libs/shared/middleware/tsconfig.lib.json"
    }
  ]
}
