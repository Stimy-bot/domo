{
  "name": "@domo/my_encore",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "cwd": "apps/my_encore",
        "command": "pnpm --filter @domo/my_encore run build"
      },
      "outputs": ["{workspaceRoot}/dist/apps/my_encore/**"]
    },
    "serve": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "cwd": "apps/my_encore",
        "command": "encore run"
      },
      "configurations": {
        "production": {
          "command": "pnpm --filter @domo/my_encore run start -- --env production"
        }
      },
      "outputs": []
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/my_encore",
        "command": "pnpm --filter @domo/my_encore run check"
      },
      "outputs": []
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/my_encore",
        "command": "pnpm --filter @domo/my_encore run test"
      },
      "outputs": []
    }
  }
}
