{
  "name": "@domo/my_encore",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "targets": {
    "build": {
      "command": "encore check",
      "options": {
        "cwd": "apps/my_encore"
      }
    },
    "serve": {
