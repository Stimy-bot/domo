{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "rootDir": "./src",
    "composite": true,
    "declaration": true,
    "sourceMap": true,
    "module": "ES2022",
    "target": "ES2022",
    "moduleResolution": "bundler",
    "types": ["node"],
    "paths": {
      "~encore/*": ["./encore.gen/*"],
      "@domo/*": ["../../libs/*/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
