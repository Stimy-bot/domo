{
  "name": "@domo/my_api",
  "version": "1.0.0",
  "type": "module",
  "description": "This project was bootstrapped with Fastify-CLI.",
  "main": "app.ts",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "node -e \"fs.rmSync('coverage', { recursive: true, force: true })\" && c8 node --import tsx --test \"test/**/*.ts\"",
    "start": "npm run build:ts && cd ../../dist/apps/fastify && fastify start -l info app/app.js",
    "build:ts": "tsc --project tsconfig.json --outDir ../../dist/apps/fastify && cpx \"views/**/*\" ../../dist/apps/fastify/views",
    "watch:ts": "concurrently \"tsc -w --outDir ../../dist/apps/fastify\" \"cpx \"views/**/*\" ../../dist/apps/fastify/views -w\"",
    "dev": "npm run build:ts && concurrently -k -p \"[{name}]\" -n \"TypeScript,App\" -c \"yellow.bold,cyan.bold\" \"npm:watch:ts\" \"npm:dev:start\"",
    "dev:start": "fastify start --ignore-watch=.ts$ -w -l info -P ../../dist/apps/fastify/app/app.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {

  }
}
