{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc/apps/my_start",
    "moduleResolution": "bundler",
    "types": ["vitest/globals", "node"],
    "composite": false,
    "declaration": false,
    "emitDeclarationOnly": false,
    "noEmit": true
  },
  "include": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.tsx",
    "src/**/*.test.tsx",
    "src/**/*.d.ts"
  ]
}
