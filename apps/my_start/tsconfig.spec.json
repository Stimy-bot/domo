{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/apps/my_start",
    "moduleResolution": "bundler",
    "types": [
      "vitest/globals",
      "node"
    ],
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": false,
    "noEmit": false,
  },
  "include": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.tsx",
    "src/**/*.test.tsx",
    "src/**/*.d.ts"
  ]
}