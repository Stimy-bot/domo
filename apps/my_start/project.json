{
  "name": "@domo/my_start",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "serve-static": {
      "executor": "@nx/vite:serve-static",
      "options": {
        "buildTarget": "@domo/my_start:build",
        "spa": true,
        "outputPath": "dist/apps/my_start/client"
      }
    },
    "dev": {
      "options": {
        "config": "vite.config.ts",
        "port": 5173
      }
    },
    "serve": {
      "options": {
        "config": "vite.config.ts"
      }
    },
    "build": {
      "options": {
        "config": "vite.config.ts",
        "outDir": "../../dist/apps/my_start"
      }
    },
    "preview": {
      "options": {
        "config": "vite.config.ts"
      }
    },
    "lint": {
      "options": {
        "args": ["src/**/*.ts", "src/**/*.tsx"]
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "options": {
        "passWithNoTests": true
      }
    }
  }
}
