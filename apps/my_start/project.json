{
  "name": "@domo/my_start",
  "projectType": "application",
  "sourceRoot": "apps/my_start/src",
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "options": {
        "outputPath": "dist/apps/my_start",
        "config": "apps/my_start/vite.config.ts"
      }
    },
    "serve": {
      "executor": "@nx/vite:dev",
      "options": {
        "buildTarget": "@domo/my_start:build",
        "config": "apps/my_start/vite.config.ts"
      }
    }
  }
}
