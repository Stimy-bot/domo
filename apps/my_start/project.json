{
  "name": "@domo/my_start",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "build": {
      "outputs": ["{projectRoot}/{options.outDir}", "{projectRoot}/dist"],
      "defaultConfiguration": "production",
      "options": {
        "config": "./vite.config.ts",
        "outDir": "../../dist/apps/my_start"
      },
      "configurations": {
