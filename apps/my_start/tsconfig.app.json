{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/apps/my_start",
    "types": ["node", "@tanstack/react-start"],
    "rootDir": "../../",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "jsx": "react-jsx",
    "noEmit": false,
    "emitDeclarationOnly": false,
    "composite": false,
    "declaration": false
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "global.d.ts",
    ".vinxi/types/**/*.d.ts",
    ".tanstack/**/*.d.ts"
  ]
}