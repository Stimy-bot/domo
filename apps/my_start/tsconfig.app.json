{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "#/*": ["./src/*"],

      /* Map specific workspace library packages */
      "@domo/shared-config": ["../../libs/shared/config/src/index.ts"],
      "@domo/shared-utils": ["../../libs/shared/utils/src/index.ts"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts"
  ],
  "references": [
    { "path": "../../libs/shared/config/tsconfig.lib.json" },
    { "path": "../../libs/shared/utils/tsconfig.lib.json" },
    { "path": "../../libs/shared/reusableComponents/tsconfig.lib.json" },
    { "path": "../../libs/shared/ui-buttons/tsconfig.lib.json" }
  ]
}