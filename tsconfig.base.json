{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2022", "dom", "dom.iterable"],
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@domo/*": ["apps/*/src", "libs/*/src"],
      "@domo/ui-buttons": ["./libs/shared/ui-buttons/src/index.ts"],
      "@domo/ui-footer": ["./libs/shared/ui-footer/src/index.ts"],
      "@domo/ui-header": ["./libs/shared/ui-header/src/index.ts"],
      "@domo/ui-sidebar": ["./libs/shared/ui-sidebar/src/index.ts"]
    },
    "typeRoots": ["./types", "./node_modules/@types"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "importHelpers": true,
    "isolatedModules": true,
    "customConditions": ["@domo/source"],
    "noUncheckedSideEffectImports": false
  }
}
