{
  "compileOnSave": false,
  "compilerOptions": {
    /* Language & Environment */
    "jsx": "react-jsx",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "typeRoots": ["./node_modules/@types", "./types"],

    /* Modules & Resolution */
    "module": "preserve",
    "moduleResolution": "bundler",
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@domo/*": [".libs/*"],
      "@domo/my_fastapi": ["./apps/my_fastapi/*"],
      "@domo/my_fastify": ["./apps/my_fastify/src/index.ts"],
      "@domo/my_fastify/*": ["./apps/my_fastify/src/*"],
      "@domo/my_encore": ["./app/my_encore"],
      "@domo/my_vite": ["./apps/my_vite/src/index.ts"],
      "@domo/my_vite/*": ["./apps/my_vite/src/*"],
      "@domo/my_start": ["./apps/my_start/src/index.ts"],
      "@domo/my_start/*": ["./apps/my_start/src/*"],
      "@domo/client": ["./libs/shared/client/src/index.ts"],
      "@domo/client/*": ["./libs/shared/client/src/*"],
      "@domo/config": ["./libs/shared/config/src/index.ts"],
      "@domo/config/*": ["./libs/shared/config/src/*"],
      "@domo/constants": ["./libs/shared/constants/src/index.ts"],
      "@domo/constants/*": ["./libs/shared/constants/src/*"],
      "@domo/context": ["./libs/shared/context/src/index.ts"],
      "@domo/context/*": ["./libs/shared/context/src/*"],
      "@domo/controllers": ["./libs/shared/controllers/src/index.ts"],
      "@domo/controllers/*": ["./libs/shared/controllers/src/*"],
      "@domo/firebase": ["./libs/shared/firebase/src/index.ts"],
      "@domo/firebase/*": ["./libs/shared/firebase/src/*"],
      "@domo/forms": ["./libs/shared/forms/src/index.ts"],
      "@domo/forms/*": ["./libs/shared/forms/src/*"],
      "@domo/hooks": ["./libs/shared/hooks/src/index.ts"],
      "@domo/hooks/*": ["./libs/shared/hooks/src/*"],
      "@domo/middleware": ["./libs/shared/middleware/src/index.ts"],
      "@domo/middleware/*": ["./libs/shared/middleware/src/*"],
      "@domo/models": ["./libs/shared/models/src/index.ts"],
      "@domo/models/*": ["./libs/shared/models/src/*"],
      "@domo/reusableComponents": ["./libs/shared/reusableComponents/src/index.ts"],
      "@domo/reusableComponents/*": ["./libs/shared/reusableComponents/src/*"],
      "@domo/schemas": ["./libs/shared/schemas/src/index.ts"],
      "@domo/schemas/*": ["./libs/shared/schemas/src/*"],
      "@domo/services": ["./libs/shared/services/src/index.ts"],
      "@domo/services/*": ["./libs/shared/services/src/*"],
      "@domo/state": ["./libs/shared/state/src/index.ts"],
      "@domo/state/*": ["./libs/shared/state/src/*"],
      "@domo/types": ["./libs/shared/types/src/index.ts"],
      "@domo/types/*": ["./libs/shared/types/src/*"],
      "@domo/ui-buttons": ["./libs/shared/ui-buttons/src/index.ts"],
      "@domo/ui-buttons/*": ["./libs/shared/ui-buttons/src/*"],
      "@domo/ui-footer": ["./libs/shared/ui-footer/src/index.ts"],
      "@domo/ui-footer/*": ["./libs/shared/ui-footer/src/*"],
      "@domo/ui-header": ["./libs/shared/ui-header/src/index.ts"],
      "@domo/ui-header/*": ["./libs/shared/ui-header/src/*"],
      "@domo/ui-sidebar": ["./libs/shared/ui-sidebar/src/index.ts"],
      "@domo/ui-sidebar/*": ["./libs/shared/ui-sidebar/src/*"],
      "@domo/utils": ["./libs/shared/utils/src/index.ts"],
      "@domo/utils/*": ["./libs/shared/utils/src/*"],
      "@domo/validates": ["./libs/shared/validates/src/index.ts"],
      "@domo/validates/*": ["./libs/shared/validates/src/*"],
      "@domo/tailwind-sync-plugin": ["./tools/tailwind-sync-plugin/src/index.ts"],
      "@domo/config/client": ["./libs/shared/config/src/env.client.ts"],
      "@domo/config/server": ["./libs/shared/config/src/env.server.ts"],
      "@domo/constants/client": ["./libs/shared/constants/src/lib/env.client.ts"],
      "@domo/constants/server": ["./libs/shared/constants/src/lib/env.server.ts"],
      "@domo/utils/client": ["./libs/shared/utils/src/jwt.client.ts"],
      "@domo/utils/server": ["./libs/shared/utils/src/jwt.server.ts"],
      "@domo/tailwind-sync-plugin/*": ["./tools/tailwind-sync-plugin/src/*"]
    },

    /* Emit & Build Performance */
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    /* Modern Type Checking & Safety */
    "strict": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,

    /* Bundler Interop & Standards */
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,

    /* Speed & System */
    "skipLibCheck": true
  },
  "exclude": ["node_modules", "tmp", "dist", "build", "coverage"]
}
